# Copy this file to load-testing/k6/.env and edit values locally.
# Do not commit real session tokens.

BASE_URL=https://entreporgneur-big-journey-7b03.twc1.net

# public, auth, or flight
MODE=auth

# Total target across all laptops. The runner splits this by MACHINE_TOTAL.
TOTAL_VUS=100
MACHINE_TOTAL=2
MACHINE_INDEX=1

RAMP_UP=30s
HOLD=2m
RAMP_DOWN=30s
THINK_TIME_SECONDS=1

# Optional: coordinate a shared start.
# START_DELAY_SECONDS=60
# START_AT_EPOCH=1799820000

# Auth options.
# Prefer TOKENS_FILE over putting secrets directly in this file.
TOKENS_FILE=load-testing/k6/tokens.txt
# SESSION_TOKEN=
# SESSION_TOKENS=

# Flight options. This changes player state, so use carefully.
ROUTE_ID=kazan-moscow
FLIGHT_ITERATIONS=1
FLIGHT_THINK_TIME_SECONDS=3
FLIGHT_HAPPINESS=90
FLIGHT_COLLECTED_COINS=0
